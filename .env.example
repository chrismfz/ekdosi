APP_NAME=ekdosi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── PRODUCTION ─────────────────────────────────────────────────────────────
# On a live host these MUST be:
#   APP_ENV=production
#   APP_DEBUG=false            # APP_DEBUG=true leaks stack traces + env/secrets
#   APP_URL=https://your.real.domain   # absolute PDF/email/QR/MARK/webhook links
# After editing any cached value: php artisan config:clear && php artisan optimize
# ────────────────────────────────────────────────────────────────────────────

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Force every operator to set up TOTP 2FA on next login. Default OFF (opt-in via
# the profile page) so flipping it can't lock the team out mid-flight — enrol
# everyone first, THEN set true.
# EKDOSI_REQUIRE_2FA=false

# Secrets at-rest encryption (DR / «work without APP_KEY»). Default FALSE →
# secret columns (myDATA/GSIS/SMTP/WHMCS keys, server creds, 2FA, backup
# passphrase) are stored PLAINTEXT, so a plain mysqldump restore on a new VM
# needs NO old APP_KEY. Protection = DB/disk access control. Set true to encrypt
# at rest under APP_KEY (then DR must carry the key). After flipping, run
# `php artisan secrets:reencrypt --to=plain|encrypted`. See docs/dr-without-app-key.md.
# EKDOSI_ENCRYPT_SECRETS_AT_REST=false
# SEC-1: when you keep plaintext (the default), acknowledge it EXPLICITLY so
# go-live-check passes instead of warning — a conscious "DB/backup access
# control is our trust boundary" choice. See docs/security-at-rest.md.
# EKDOSI_SECRETS_PLAINTEXT_ACKNOWLEDGED=true

# OPS-3: email the ops recipients on an unhandled exception (best-effort,
# deduped per error signature within the throttle window). Default ON; recipients
# fall back to EKDOSI_BACKUP_ALERT_EMAIL → super_admins when the dedicated one
# is unset. Set enabled=false in local dev to silence.
# EKDOSI_ERROR_ALERTS=true
# EKDOSI_ERROR_ALERT_EMAIL=ops@example.gr       # comma-separated; optional
# EKDOSI_ERROR_ALERT_THROTTLE_MINUTES=30

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ekdosi
DB_USERNAME=ekdosi
DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Scheduler tasks (routes/console.php) ────────────────────────────────────
# These are the per-task on/off switches. They do NOTHING until the OS cron
# (`* * * * * cd /path && php artisan schedule:run`) AND a queue worker
# (queue:work) are both live — those are the real master switches.
#
# All default to the value shown below if the var is ABSENT, so on a normal
# deploy you do NOT need to set them — they're already on (except auto-issue,
# which is deliberately off). List them only to DISABLE a task or retune cron.
# After changing any of these on a config-cached host: php artisan config:clear
#
# EKDOSI_SCHEDULE_MAIL_SWEEP=true              # recover crashed-worker mail rows (every 15m)
# EKDOSI_MAIL_SWEEP_THRESHOLD=15               # minutes before a stuck queued/sending mail row → failed
# EKDOSI_SCHEDULE_RESEND_FAILED_EMAILS=false   # re-queue invoices whose last mail attempt failed — OFF (a mail outage would mass-requeue)
# EKDOSI_RESEND_FAILED_EMAILS_CRON="30 * * * *"
# EKDOSI_RESEND_FAILED_EMAILS_SINCE=3          # only re-queue failures from the last N days
# EKDOSI_SCHEDULE_WHMCS_FETCH=true             # stage paid WHMCS invoices into the inbox (every 15m)
# EKDOSI_WHMCS_FETCH_CRON="*/15 * * * *"
# EKDOSI_SCHEDULE_MYDATA_RECONCILE=true        # daily read-only local↔AADE cross-check
# EKDOSI_MYDATA_RECONCILE_TIME=06:00
# EKDOSI_SCHEDULE_MYDATA_VAT_PICTURE=true      # cache the dashboard ΦΠΑ snapshot (heavy AADE pull)
# EKDOSI_MYDATA_VAT_PICTURE_CRON="0 */4 * * *"
# EKDOSI_SCHEDULE_WHMCS_AUTO_ISSUE=false       # auto-FILE γκρινιάρης rows at AADE — OFF (two-key armed)
# EKDOSI_WHMCS_AUTO_ISSUE_CRON="*/15 * * * *"
# EKDOSI_SCHEDULE_OVERDUE_NOTIFICATIONS=false   # daily «bell» digest of overdue invoices — OFF by default (set true in prod)
# EKDOSI_OVERDUE_NOTIFICATIONS_TIME=07:30
# EKDOSI_SCHEDULE_SERVICE_RENEWALS=false        # stage DRAFT renewal invoices for due service contracts — OFF (creates real drafts; operator reviews before AADE)
# EKDOSI_SERVICE_RENEWALS_TIME=07:00
# EKDOSI_SERVICE_RENEWALS_LEAD_DAYS=0           # also stage contracts due within the next N days (early billing)
# EKDOSI_SCHEDULE_SERVICE_DUNNING=true          # auto suspend/terminate contracts with overdue renewals (or unsuspend a paid one).
#                                               # ON by default = the engine is "plugged in", BUT nothing happens until a
#                                               # PRODUCT opts in: per-product `dunning_enabled` is the real switch and
#                                               # defaults OFF, so a fresh deploy is a no-op. Per-contract dunning_enabled
#                                               # can override (null = inherit the product). DESTRUCTIVE — review before enabling a product.
# EKDOSI_SERVICE_DUNNING_TIME=08:00

# ──────────────────────────────────────────────────────────────────────────
# ekdosi app knobs. PROD: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=info,
# SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true, and a REAL mailer (MAIL_MAILER
# = smtp/...) — with MAIL_MAILER=log NOTHING is actually sent (auto-email, overdue
# notices, backup alerts all go to the log). Per-tenant myDATA/WHMCS/GSIS creds are
# in the DB (Companies form), NOT here.
# ──────────────────────────────────────────────────────────────────────────

# Demo seed (SET-1): `db:seed` builds a throwaway DEMO tenant + a demo super_admin
# with a well-known password. OFF by default (opt-in) so a stray `db:seed --force`
# on a real host can NEVER create it. Real installs: `php artisan ekdosi:install`
# (or `ekdosi:create-admin`). Set true ONLY on a dev/demo box.
# EKDOSI_SEED_DEMO=false
# EKDOSI_SEED_DEMO_PASSWORD=password

# Scheduler tasks (need the OS cron + a running queue:work worker). Defaults shown;
# omit a line to keep its default. ON by default: mail-sweep, queue-heartbeat,
# whmcs-fetch, mydata-reconcile, mydata-vat-picture, service-dunning.
# EKDOSI_SCHEDULE_MAIL_SWEEP=true
# EKDOSI_SCHEDULE_RESEND_FAILED_EMAILS=false   # ON would mass-requeue during a mail outage
# EKDOSI_SCHEDULE_WHMCS_FETCH=true
# EKDOSI_SCHEDULE_WHMCS_AUTO_ISSUE=false        # + companies.whmcs_auto_issue_immediate (two-key)
# EKDOSI_SCHEDULE_MYDATA_RECONCILE=true
# EKDOSI_SCHEDULE_MYDATA_VAT_PICTURE=true
# EKDOSI_SCHEDULE_OVERDUE_NOTIFICATIONS=false
# EKDOSI_SCHEDULE_SERVICE_RENEWALS=false
# EKDOSI_SCHEDULE_SERVICE_DUNNING=true

# WHOLE-DB backups (spatie/laravel-backup: all tenants + files) — ON by default
# (AUDIT OPS-1); they fire once the scheduler cron runs. Nightly dump 02:00,
# cleanup 02:30, health monitor 08:00.
# EKDOSI_SCHEDULE_BACKUP_RUN=true
# EKDOSI_SCHEDULE_BACKUP_CLEANUP=true
# EKDOSI_SCHEDULE_BACKUP_MONITOR=true
# Where the whole-DB archives go (comma-separated filesystems.php disks).
# PRODUCTION: add an OFF-SITE disk — a local-only copy dies with the VM.
# BACKUP_DESTINATION_DISKS=local,s3
# Encrypt the archives (they contain the full dump — with plaintext-at-rest
# secrets unless EKDOSI_ENCRYPT_SECRETS_AT_REST is on). Set a real passphrase
# in production and store it in the password manager:
# BACKUP_ARCHIVE_PASSWORD=
# Per-company automated backups (off by default). Turn on once destinations + a
# trusted target are configured per company (Companies → Αντίγραφα ασφαλείας).
# EKDOSI_SCHEDULE_COMPANY_BACKUPS=false
# Backup failure alerting (default on; always logs). ONE recipient chain for
# BOTH the whole-DB and the per-company alerts: «Ρυθμίσεις συστήματος» override
# → this env → super_admin users.
# EKDOSI_BACKUP_ALERT_ON_FAILURE=true
# EKDOSI_BACKUP_ALERT_EMAIL=ops@example.gr      # comma-separated; falls back to super_admins

# ── AI «Βοηθός» (assistant) ───────────────────────────────────────────────
# ONE global Anthropic key (transport + billing account); per-company billing is
# the in-app token meter, isolation is the tool layer. A tenant may override the
# key per-company (Companies → AI Βοηθός). Master switch is OFF by default — turn
# it on globally here, then enable per company.
# ANTHROPIC_API_KEY=sk-ant-...
# EKDOSI_AI_ENABLED=false
# EKDOSI_AI_DEFAULT_MODEL=claude-sonnet-4-6     # or claude-haiku-4-5 / claude-opus-4-8
# EKDOSI_AI_MAX_TOKENS=1024                     # per-turn output cap
# EKDOSI_AI_MAX_TOOL_ITERATIONS=6               # runaway-loop guard
# EKDOSI_AI_TIMEOUT=60
# EKDOSI_AI_RATE_PER_MINUTE=15                  # requests/min per user+company
# EKDOSI_AI_PROMPT_CACHE=true                   # prompt caching (cache reads 0.1× input); transparent
# EKDOSI_AI_GLOBAL_TOKEN_CAP=5000000            # backstop tokens/tenant/month (0 = none)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
