# ekdosi — πρότυπο .env. Ο οδηγός εγκατάστασης (/install) γράφει ΑΥΤΟΜΑΤΑ τα core
# keys· αυτό το αρχείο είναι για χειροκίνητο setup ή για να δεις τι υπάρχει.
#
# Οι ΡΥΘΜΙΣΕΙΣ ΕΦΑΡΜΟΓΗΣ (scheduler on/off, 2FA, ειδοποιήσεις backup) ρυθμίζονται
# πλέον από το UI — «Σύστημα → Χρονοπρογραμματιστής» + «Σύστημα → Ρυθμίσεις
# συστήματος». env = μόνο το DEFAULT· μια αλλαγή στο UI το υπερισχύει
# (system_settings· revert-to-default σβήνει την override). Δεν χρειάζεται .env
# edit + redeploy για αυτά.
#
# Μετά από αλλαγή cached τιμής σε host με config cache: php artisan config:clear
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME=ekdosi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Athens

# ── PRODUCTION ────────────────────────────────────────────────────────────────
# Σε live host: APP_ENV=production, APP_DEBUG=false (αλλιώς διαρρέει stack traces +
# secrets), APP_URL=https://το.πραγματικό.domain (absolute PDF/email/QR/MARK/webhook
# links), SESSION_SECURE_COOKIE=true, και ΠΡΑΓΜΑΤΙΚΟΣ mailer (ΟΧΙ log).
# ──────────────────────────────────────────────────────────────────────────────

# Καθαρά ελληνική εφαρμογή → el (ο installer γράφει τα ίδια). fallback=en = ασφαλής
# εφεδρεία αν λείπει ελληνικό string από framework/vendor.
APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=el_GR

BCRYPT_ROUNDS=12

# ── Logs ──────────────────────────────────────────────────────────────────────
# PROD: LOG_LEVEL=info + ΠΕΡΙΣΤΡΟΦΗ (LOG_STACK=daily → κρατά LOG_DAILY_DAYS αρχεία,
# ή OS logrotate). Το default `single` είναι ΕΝΑ αρχείο που δεν περιστρέφεται ποτέ.
LOG_CHANNEL=stack
LOG_STACK=single
# LOG_STACK=daily
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ekdosi
DB_USERNAME=ekdosi
DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ── Session / Cache / Queue / Filesystem (όλα DB/local — κανένα Redis) ─────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true          # PROD πάνω από HTTPS

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ── Mail (global transport· τα per-tenant SMTP είναι στη DB, ΟΧΙ εδώ) ──────────
# MAIL_MAILER=log → ΤΙΠΟΤΑ δεν στέλνεται πραγματικά (auto-email, ληξιπρόθεσμα,
# backup alerts πάνε στο log). PROD: smtp/... με ΠΡΑΓΜΑΤΙΚΟ mailer.
MAIL_MAILER=log
# MAIL_SCHEME=smtp                    # STARTTLS· smtps = TLS-on-connect
                                      # (ΟΧΙ οι παλιές τιμές tls/ssl — η Symfony τις απορρίπτει)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.gr"
MAIL_FROM_NAME="${APP_NAME}"

# ── Secrets at-rest / DR (ΜΕΝΕΙ env — GeneralSettings τα δείχνει read-only) ────
# Default FALSE = τα secret columns (myDATA/GSIS/SMTP/WHMCS keys, server creds, 2FA,
# backup passphrase) αποθηκεύονται PLAINTEXT → ένα plain mysqldump αρκεί για DR σε
# νέο VM ΧΩΡΙΣ το παλιό APP_KEY· όριο εμπιστοσύνης = πρόσβαση DB/δίσκου. TRUE =
# κρυπτογράφηση υπό APP_KEY (τότε το DR ΠΡΕΠΕΙ να κουβαλά το κλειδί)· μετά το flip:
# php artisan secrets:reencrypt --to=plain|encrypted. Δες docs/security-at-rest.md.
# EKDOSI_ENCRYPT_SECRETS_AT_REST=false
# Κρατώντας plaintext (default): αναγνώρισέ το ΡΗΤΑ ώστε να περνά το go-live-check.
EKDOSI_SECRETS_PLAINTEXT_ACKNOWLEDGED=true

# ── Demo seed (dev-only footgun guard· ΜΕΝΕΙ env) ─────────────────────────────
# `db:seed` φτιάχνει throwaway DEMO tenant + demo super_admin με γνωστό κωδικό.
# OFF by default ώστε ένα κατά λάθος `db:seed --force` σε πραγματικό host να μην τον
# δημιουργεί ΠΟΤΕ. Πραγματικά installs: php artisan ekdosi:install. true ΜΟΝΟ σε dev.
# EKDOSI_SEED_DEMO=false
# EKDOSI_SEED_DEMO_PASSWORD=password

# ══════════════════════════════════════════════════════════════════════════════
# ΡΥΘΜΙΣΕΙΣ ΑΠΟ ΤΟ UI (system_settings) — ΔΕΝ χρειάζονται .env edit:
#   • Scheduler on/off (17 tasks) ......... Σύστημα → Χρονοπρογραμματιστής
#   • Υποχρεωτικό 2FA (TOTP) .............. Σύστημα → Ρυθμίσεις συστήματος
#   • Ειδοποίηση email σε αποτυχία backup . Σύστημα → Ρυθμίσεις συστήματος
# env = μόνο τα defaults· το UI υπερισχύει. Ούτως ή άλλως ΚΑΝΕΝΑ scheduled task δεν
# τρέχει χωρίς OS cron (`* * * * * … php artisan schedule:run`) + queue worker.
# ══════════════════════════════════════════════════════════════════════════════

# ── Cron / χρονισμός overrides (τα on/off στο UI· εδώ μόνο το «πότε») ──────────
# 5-field cron για τα *_CRON, HH:MM για τα *_TIME. Σχολιασμένο = default (config/ekdosi.php).
# EKDOSI_WHMCS_FETCH_CRON="*/15 * * * *"
# EKDOSI_MYDATA_RECONCILE_TIME=06:00
# EKDOSI_MYDATA_VAT_PICTURE_CRON="0 */4 * * *"
# EKDOSI_MYDATA_CONSOLE_REFRESH_CRON="0 */6 * * *"
# EKDOSI_MYDATA_FETCH_EXPENSES_CRON="0 */6 * * *"
# EKDOSI_MAIL_SWEEP_THRESHOLD=15                # λεπτά πριν ένα κολλημένο mail row → failed
# EKDOSI_RESEND_FAILED_EMAILS_CRON="30 * * * *"
# EKDOSI_RESEND_FAILED_EMAILS_SINCE=3
# EKDOSI_SERVICE_RENEWALS_TIME=07:00
# EKDOSI_SERVICE_RENEWALS_LEAD_DAYS=0
# EKDOSI_SERVICE_DUNNING_TIME=08:00
# EKDOSI_OVERDUE_NOTIFICATIONS_TIME=07:30
# EKDOSI_MYDATA_INDOUBT_GRACE_MINUTES=10

# ── Whole-DB backups (spatie/laravel-backup· on/off στο UI, cron εδώ) ──────────
# Default: nightly dump 02:00, cleanup 02:30, monitor 08:00 (μόλις τρέξει ο cron).
# EKDOSI_BACKUP_RUN_CRON="0 2 * * *"
# EKDOSI_BACKUP_CLEANUP_CRON="30 2 * * *"
# EKDOSI_BACKUP_MONITOR_CRON="0 8 * * *"
# EKDOSI_COMPANY_BACKUPS_CRON="0 * * * *"       # ωριαία· κάθε εταιρία στη δική της συχνότητα
# PROD: πρόσθεσε OFF-SITE disk (ένα local-only αντίγραφο πεθαίνει μαζί με το VM) +
# κωδικό αρχειοθήκης (το dump περιέχει τα plaintext-at-rest secrets):
# BACKUP_DESTINATION_DISKS=local,s3
# BACKUP_ARCHIVE_PASSWORD=
# S3 off-site (μόνο αν το βάλεις στο BACKUP_DESTINATION_DISKS):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=

# ── Error alerts (OPS-3· email σε unhandled exception, deduped) ───────────────
# Ρυθμίζεται από το UI: Σύστημα → Ρυθμίσεις συστήματος (on/off + email + throttle).
# Οι παρακάτω env είναι μόνο τα defaults (το UI τα υπερισχύει).
# EKDOSI_ERROR_ALERTS=true
# EKDOSI_ERROR_ALERT_EMAIL=ops@example.gr       # comma-sep· fallback → super_admins
# EKDOSI_ERROR_ALERT_THROTTLE_MINUTES=30

# ── AI «Βοηθός» ───────────────────────────────────────────────────────────────
# Ο ΚΑΘΟΛΙΚΟΣ διακόπτης ρυθμίζεται από το UI (Σύστημα → Ρυθμίσεις συστήματος)·
# το κλειδί/model/caps ΜΕΝΟΥΝ εδώ/config (secret). per-company override στη DB.
# ANTHROPIC_API_KEY=sk-ant-...
# EKDOSI_AI_ENABLED=false                       # default· το UI υπερισχύει
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# ── Update check (read-only «είναι ενημερωμένο;») ─────────────────────────────
# On/off από το UI (Σύστημα → Ρυθμίσεις συστήματος)· repo/token/cache μένουν env.
# Token ΜΟΝΟ για private repo.
# EKDOSI_UPDATE_CHECK=true                       # default· το UI υπερισχύει
# EKDOSI_UPDATE_REPO=chrismfz/ekdosi
# EKDOSI_UPDATE_TOKEN=                          # ή GITHUB_TOKEN· read-only PAT

# (Το endpoint /mcp είναι πάντα-ενεργό, προστατευμένο με auth — δεν υπάρχει flag· δες MCP.md.)
