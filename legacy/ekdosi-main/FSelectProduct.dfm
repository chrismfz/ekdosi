  object QryProduct: TIBQuery
    Database = FrmMain.database
    Transaction = FrmMain.IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      
        'SELECT PRODUCT.*,PRODUCT_CATEGORIES.DESCRIPTION_SHORT  AS CATEGO' +
        'RY'
      
        'FROM PRODUCT INNER JOIN PRODUCT_CATEGORIES ON  PRODUCT.CAT_ID = ' +
        'PRODUCT_CATEGORIES.CAT_ID'
      'ORDER BY'
      'PRODUCT.DESCRIPTION_SHORT ASC')
    Left = 324
    Top = 144
    object QryProductPRODUCT_ID: TIntegerField
      FieldName = 'PRODUCT_ID'
      Origin = '"PRODUCT"."PRODUCT_ID"'
      ProviderFlags = [pfInUpdate, pfInWhere, pfInKey]
      Required = True
    end
    object QryProductBARCODE: TIBStringField
      FieldName = 'BARCODE'
      Origin = '"PRODUCT"."BARCODE"'
      Size = 25
    end
    object QryProductDESCRIPTION_SHORT: TIBStringField
