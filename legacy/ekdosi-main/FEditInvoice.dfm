    InsertSQL.Strings = (
      'insert into "INVLINES"'
      
        '  ("INVLINES"."DISCOUNT", "INVLINES"."INVOICE_ID", "INVLINES"."N' +
        'OTES", '
      
        '   "INVLINES"."PRICE", "INVLINES"."PRICE_PER_ITEM", "INVLINES"."' +
        'PRICEWVAT", '
      
        '   "INVLINES"."PRODUCT_ID", "INVLINES"."QTY", "INVLINES"."VATPER' +
        'CENT")'
      'values'
      
        '  (:"DISCOUNT", :"INVOICE_ID", :"NOTES", :"PRICE", :"PRICE_PER_I' +
        'TEM", :"PRICEWVAT", '
      '   :"PRODUCT_ID", :"QTY", :"VATPERCENT")')
    RefreshSQL.Strings = (
      'Select '
      '  "INVLINES"."INVLINE_ID",'
      '  "INVLINES"."INVOICE_ID",'
      '  "INVLINES"."PRODUCT_ID",'
      '  "INVLINES"."QTY",'
      '  "INVLINES"."PRICE_PER_ITEM",'
      '  "INVLINES"."DISCOUNT",'
      '  "INVLINES"."VATPERCENT",'
      '  "INVLINES"."NOTES",'
      '  "INVLINES"."PRICE",'
      '  "INVLINES"."PRICEWVAT",'
      '  "PRODUCT"."DESCRIPTION_SHORT"'
      
        'from "INVLINES" INNER JOIN PRODUCT ON INVLINES.PRODUCT_ID = PROD' +
        'UCT.PRODUCT_ID'
      'where'
      '  "INVLINES"."INVLINE_ID" = :"INVLINE_ID"')
    SelectSQL.Strings = (
      'SELECT INVLINES.*, PRODUCT.DESCRIPTION_SHORT, PRODUCT.BARCODE'
      
        'FROM INVLINES INNER JOIN PRODUCT ON INVLINES.PRODUCT_ID = PRODUC' +
        'T.PRODUCT_ID'
      'WHERE '
      'INVOICE_ID  = :INVOICE_ID')
    ModifySQL.Strings = (
      'update "INVLINES"'
      'set'
      '  "INVLINES"."DISCOUNT" = :"DISCOUNT",'
      '  "INVLINES"."INVOICE_ID" = :"INVOICE_ID",'
      '  "INVLINES"."NOTES" = :"NOTES",'
