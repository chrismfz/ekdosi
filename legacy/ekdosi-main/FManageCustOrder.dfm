  object DatasetCustOrder: TIBDataSet
    Database = FrmMain.database
    Transaction = FrmMain.IBTransaction1
    AfterScroll = DatasetCustOrderAfterScroll
    BufferChunks = 1000
    CachedUpdates = False
    RefreshSQL.Strings = (
      'Select '
      '  "CUSTOMER"."CUST_ID",'
      '  "CUSTOMER"."AFM",'
      '  "CUSTOMER"."NAME",'
      '  ADDRESS1 || '#39' '#39' || ADDRESS2 AS ADDR'
      'from "CUSTOMER" '
      'where'
      '  "CUSTOMER"."CUST_ID" = :"CUST_ID"')
    SelectSQL.Strings = (
      
        'SELECT "ORDER",CUST_ID, AFM, NAME, ADDRESS1 || '#39' '#39' || ADDRESS2 A' +
        'S ADDR  FROM CUSTOMER '
      'ORDER BY'
      '"ORDER" ASC')
    ParamCheck = True
    UniDirectional = False
    Filtered = True
    Left = 376
    Top = 96
    object DatasetCustOrderAFM: TIBStringField
      FieldName = 'AFM'
      Origin = '"CUSTOMER"."AFM"'
    end
