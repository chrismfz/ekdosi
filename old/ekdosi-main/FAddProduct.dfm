  object DatasetProduct: TIBDataSet
    Database = FrmMain.database
    Transaction = FrmMain.IBTransaction1
    BufferChunks = 1000
    CachedUpdates = False
    InsertSQL.Strings = (
      'insert into "PRODUCT"'
      
        '  ("PRODUCT"."BARCODE", "PRODUCT"."BUY_PRICE", "PRODUCT"."CAT_ID' +
        '", "PRODUCT"."DESCRIPTION", '
      
        '   "PRODUCT"."DESCRIPTION_SHORT", "PRODUCT"."PRICE_WVAT", "PRODU' +
        'CT"."PRODUCT_ID", '
      
        '   "PRODUCT"."RESERVE", "PRODUCT"."RESERVE_SECURE", "PRODUCT"."S' +
        'ELL_PRICE", '
      '   "PRODUCT"."VATCAT_ID", "PRODUCT"."METRIC_ID")'
      'values'
      
        '  (:"BARCODE", :"BUY_PRICE", :"CAT_ID", :"DESCRIPTION", :"DESCRI' +
        'PTION_SHORT", '
      
        '   :"PRICE_WVAT", :"PRODUCT_ID", :"RESERVE", :"RESERVE_SECURE", ' +
        ':"SELL_PRICE", '
      '   :"VATCAT_ID", :"METRIC_ID")')
    RefreshSQL.Strings = (
      'Select '
      '  "PRODUCT"."PRODUCT_ID",'
      '  "PRODUCT"."BARCODE",'
      '  "PRODUCT"."DESCRIPTION_SHORT",'
      '  "PRODUCT"."CAT_ID",'
      '  "PRODUCT"."VATCAT_ID",'
      '  "PRODUCT"."BUY_PRICE",'
      '  "PRODUCT"."SELL_PRICE",'
      '  "PRODUCT"."PRICE_WVAT",'
      '  "PRODUCT"."DATE_INSERTED",'
      '  "PRODUCT"."RESERVE",'
      '  "PRODUCT"."RESERVE_SECURE",'
      '  "PRODUCT"."DESCRIPTION",'
      '  "PRODUCT"."METRIC_ID"'
      'from "PRODUCT" '
      'where'
      '  "PRODUCT"."CAT_ID" = :"CAT_ID"')
    SelectSQL.Strings = (
      'SELECT * FROM PRODUCT')
    ParamCheck = True
    UniDirectional = False
    Left = 460
    Top = 208
