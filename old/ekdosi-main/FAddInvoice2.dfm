      'from "INVOICE" '
      'where'
      '  "INVOICE"."INVOICE_ID" = :"INVOICE_ID"')
    SelectSQL.Strings = (
      'SELECT * FROM INVOICE')
    ModifySQL.Strings = (
      'update "INVOICE"'
      'set'
      '  "INVOICE"."CUST_ID" = :"CUST_ID",'
      '  "INVOICE"."DELIVERYDATE" = :"DELIVERYDATE",'
      '  "INVOICE"."DELMETHOD_ID" = :"DELMETHOD_ID",'
