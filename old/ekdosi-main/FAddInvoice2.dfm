        '","INVOICE"."CITY","INVOICE"."POSTCODE")'
      'values'
      
        '  (:"CUST_ID", :"DELIVERYDATE", :"DELMETHOD_ID", :"DISCOUNT", :"' +
        'DISTRAIM_ID", '
      
        '   :"INVCODE", :"INVDATE", :"INVOICE_ID", :"INVTYPE", :"NOTES", ' +
        ':"PRINTED", '
      
        '   :"PAYMETH_ID", :"PRICE", :"PRICEWVAT", :"INVTIME", :"ADDRESS1' +
        '",:"ADDRESS2",:"CITY",:"POSTCODE")')
    RefreshSQL.Strings = (
      'Select '
