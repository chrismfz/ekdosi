    InsertSQL.Strings = (
      'insert into "INVOICE"'
      
        '  ("INVOICE"."CUST_ID", "INVOICE"."DELIVERYDATE", "INVOICE"."DEL' +
        'METHOD_ID", '
      
        '   "INVOICE"."DISCOUNT", "INVOICE"."DISTRAIM_ID", "INVOICE"."INV' +
