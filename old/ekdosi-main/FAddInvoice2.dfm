      '   :"PRODUCT_ID", :"QTY", :"VATPERCENT",:"PRODUCT_DESCR")')
    RefreshSQL.Strings = (
      'Select '
      '  "INVLINES"."INVLINE_ID",'
      '  "INVLINES"."INVOICE_ID",'
      '  "INVLINES"."PRODUCT_ID",'
      '  "INVLINES"."QTY",'
      '  "INVLINES"."PRICE_PER_ITEM",'
      '  "INVLINES"."DISCOUNT",'
      '  "INVLINES"."VATPERCENT",'
      '  "INVLINES"."NOTES",'
      '  "INVLINES"."PRICE",'
      '  "INVLINES"."PRICEWVAT",'
      '  "INVLINES"."PRODUCT_DESCR",'
      '  "PRODUCT"."DESCRIPTION_SHORT",'
      
        '  INVLINES.PRICE_PER_ITEM*(1+(INVLINES.VATPERCENT/100)) AS PRICE' +
        '_PER_ITEM_WVAT'
      
        'from "INVLINES" INNER JOIN PRODUCT ON INVLINES.PRODUCT_ID = PROD' +
        'UCT.PRODUCT_ID'
      'where'
      '  "INVLINES"."INVLINE_ID" = :"INVLINE_ID"')
    SelectSQL.Strings = (
      'SELECT INVLINES.*, PRODUCT.DESCRIPTION_SHORT, PRODUCT.BARCODE,'
      
        '             CAST( INVLINES.PRICE_PER_ITEM*(1+( CAST(INVLINES.VA' +
        'TPERCENT AS NUMERIC(15,4))/100 )) AS NUMERIC(15,2)) AS PRICE_PER' +
        '_ITEM_WVAT'
      
        'FROM INVLINES INNER JOIN PRODUCT ON INVLINES.PRODUCT_ID = PRODUC' +
        'T.PRODUCT_ID'
      'WHERE '
      'INVOICE_ID IS NULL')
    ModifySQL.Strings = (
      'update "INVLINES"'
      'set'
      '  "INVLINES"."DISCOUNT" = :"DISCOUNT",'
      '  "INVLINES"."INVOICE_ID" = :"INVOICE_ID",'
      '  "INVLINES"."NOTES" = :"NOTES",'
      '  "INVLINES"."PRICE" = :"PRICE",'
      '  "INVLINES"."PRICE_PER_ITEM" = :"PRICE_PER_ITEM",'
      '  "INVLINES"."PRICEWVAT" = :"PRICEWVAT",'
      '  "INVLINES"."PRODUCT_ID" = :"PRODUCT_ID",'
      '  "INVLINES"."QTY" = :"QTY",'
      '  "INVLINES"."VATPERCENT" = :"VATPERCENT",'
      '  "INVLINES"."PRODUCT_DESCR" = :"PRODUCT_DESCR"'
      'where'
      '  "INVLINES"."INVLINE_ID" = :"OLD_INVLINE_ID"')
    ParamCheck = True
    UniDirectional = False
    Left = 668
    Top = 296
